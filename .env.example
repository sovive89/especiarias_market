# Fonte de dados do app
# mock = dados simulados em memória (padrão, sem banco)
# http = backend real (endpoints em docs/API.md)
VITE_DATA_SOURCE=mock

# Só usado quando VITE_DATA_SOURCE=http
VITE_API_URL=

# Bot de notificações do WhatsApp Business (opcional — sem isso o bot fica "não configurado"
# e o resto do app funciona normalmente). Passo a passo em docs/WHATSAPP.md.
# NUNCA use o prefixo VITE_ aqui: essas variáveis só podem existir no servidor.
WHATSAPP_TOKEN=
WHATSAPP_PHONE_NUMBER_ID=
# Opcional — versão da Graph API da Meta (padrão: v21.0)
WHATSAPP_API_VERSION=
